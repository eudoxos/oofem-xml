<oofem version="1">
  <Output>nltrans_incr.out.sm</Output>
  <Description>Quadrilateral elements subjected to temperature strains, changes in static system</Description>
  <Analysis _="IncrLinearStatic" endoftimeofinterest="3.0" prescribedtimes="1.0 2.0 3.0"/>
  <!-- vtkxml tstep_all vars 2 1 4 primvars 1 1 stype 1 -->
  <Domain domain="2dplanestress">
    <OutputManager tstep_all="" dofman_all="" element_all=""/>
    <Nodes>
      <Node coords="0.0 0.0 0.0"/>
      <Node coords="0.1 0.0 0.0"/>
      <Node coords="0.2 0.0 0.0"/>
      <Node coords="0.0 1.0 0.0"/>
      <Node id="5" coords="0.1 1.0 0.0"/>
