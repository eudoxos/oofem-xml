      <Node coords="0.0 2.0 0.0"/>
      <Node coords="0.1 2.0 0.0"/>
      <Node coords="0.2 2.0 0.0"/>
    </Nodes>
    <Elements>
      <planestress2d nodes="1 2 5 4"/>
      <planestress2d nodes="2 3 6 5"/>
      <planestress2d nodes="4 5 8 7"/>
      <planestress2d nodes="5 6 9 8"/>
    </Elements>
    <CrossSections>
      <SimpleCS thick="1.0" material="1" set="1"/>
    </CrossSections>
    <Materials>
      <IsoLe d="2400.0" e="10000.0" n="0.15" talpha="1.2e-05"/>
    </Materials>
    <BoundaryConditions>
      <BoundaryCondition loadtimefunction="1" dofs="1" values="0.0" set="2"/>
      <BoundaryCondition loadtimefunction="1" dofs="2" values="0.0" set="3"/>
      <BoundaryCondition loadtimefunction="1" dofs="2" values="0.0" isimposedtimefunction="2" set="4"/>
    </BoundaryConditions>
    <InitialConditions/>
    <LoadTimeFunctions>
      <ConstantFunction f_t_="1.0"/>
      <UsrDefLTF f_t_="h(72000.)"/>
    </LoadTimeFunctions>
    <Sets>
      <Set elementranges="1-4"/>
      <Set nodes="1"/>
      <Set nodes="1 2 3"/>
      <Set nodes="7 8 9"/>
    </Sets>
  </Domain>
  <ExportModules>
    <errorcheck tolerance="1e-08">
      <NODE tStep="1" number="4" dof="1" unknown="d" value="3.50423014e-06"/>
