<oofem version="1">
  <Output>nonstat_nonlin_02.out.sm</Output>
  <Description>Quadrilateral elements subjected to temperature strains</Description>
  <Analysis _="staticstructural" nsteps="3"/>
  <!-- vtkxml tstep_all vars 2 1 4 primvars 1 1 stype 1 -->
  <Domain domain="2dplanestress">
    <OutputManager tstep_all="" dofman_all="" element_all=""/>
    <Nodes>
      <Node coords="0.0 0.0 0.0"/>
      <Node coords="0.1 0.0 0.0"/>
      <Node coords="0.2 0.0 0.0"/>
      <Node coords="0.0 1.0 0.0"/>
      <Node id="5" coords="0.1 1.0 0.0"/>
      <Node coords="0.2 1.0 0.0"/>
      <Node coords="0.0 2.0 0.0"/>
      <Node coords="0.1 2.0 0.0"/>
      <Node coords="0.2 2.0 0.0"/>
    </Nodes>
    <Elements>
      <planestress2d nodes="1 2 5 4"/>
      <planestress2d nodes="2 3 6 5"/>
      <planestress2d nodes="4 5 8 7"/>
      <planestress2d nodes="5 6 9 8"/>
    </Elements>
    <CrossSections>
      <SimpleCS thick="1.0" material="1" set="1"/>
    </CrossSections>
    <Materials>
      <IsoLe d="2400.0" e="10000.0" n="0.15" talpha="1.2e-05"/>
    </Materials>
    <BoundaryConditions>
      <BoundaryCondition loadtimefunction="1" dofs="1" values="0.0" set="2"/>
      <BoundaryCondition loadtimefunction="1" dofs="2" values="0.0" set="3"/>
    </BoundaryConditions>
    <InitialConditions/>
    <LoadTimeFunctions>
      <ConstantFunction f_t_="1.0"/>
    </LoadTimeFunctions>
    <Sets>
      <Set elementranges="1-4"/>
      <Set nodes="1"/>
      <Set noderanges="1-6"/>
    </Sets>
  </Domain>
  <ExportModules>
    <errorcheck tolerance="1e-08">
      <NODE tStep="1" number="2" dof="1" unknown="d" value="1.64138549e-06"/>
      <NODE tStep="1" number="4" dof="1" unknown="d" value="3.56946902e-06"/>
      <NODE tStep="1" number="9" dof="2" unknown="d" value="0.000437886192"/>
      <ELEMENT tStep="1" number="1" gp="1" keyword="4" component="1" value="-1.1738e-05"/>
      <NODE tStep="3" number="2" dof="1" unknown="d" value="4.82998209e-06"/>
      <NODE tStep="3" number="4" dof="1" unknown="d" value="2.84066269e-06"/>
      <NODE tStep="3" number="9" dof="2" unknown="d" value="0.00127956795"/>
      <ELEMENT tStep="3" number="1" gp="1" keyword="4" component="1" value="2.5896e-05"/>
    </errorcheck>
  </ExportModules>
</oofem>
