<oofem version="1">
  <Output>nltrans_incr.out.tm</Output>
  <Description>Quadrilateral elements subjected to heat flux (Newton b.c), changingProblemSize</Description>
  <Analysis _="TransientTransport" nsteps="3" deltat="36000.0" alpha="0.5" lumped="" exportfields="5"/>
  <!-- vtkxml tstep_all domain_all primvars 1 6 -->
  <Domain domain="heattransfer">
    <OutputManager tstep_all="" dofman_all="" element_all=""/>
    <Nodes>
      <Node coords="0.0 0.0 0.0"/>
      <Node coords="0.1 0.0 0.0"/>
      <Node coords="0.2 0.0 0.0"/>
      <Node coords="0.0 1.0 0.0"/>
      <Node id="5" coords="0.1 1.0 0.0"/>
      <Node coords="0.2 1.0 0.0"/>
      <Node coords="0.0 2.0 0.0"/>
      <Node coords="0.1 2.0 0.0"/>
      <Node coords="0.2 2.0 0.0"/>
    </Nodes>
    <Elements>
      <quad1ht nodes="1 2 5 4"/>
      <quad1ht nodes="2 3 6 5"/>
      <quad1ht nodes="4 5 8 7" boundaryloads="1 3"/>
      <quad1ht nodes="5 6 9 8" boundaryloads="1 3"/>
    </Elements>
    <CrossSections>
      <SimpleTransportCS thickness="1.0" mat="1" set="1"/>
    </CrossSections>
    <Materials>
      <IsoHeat d="2400.0" k="1.5" c="800.0"/>
    </Materials>
    <BoundaryConditions>
      <constantedgeload loadtimefunction="1" dofs="10" components="-2000.0" loadtype="2"/>
      <BoundaryCondition loadtimefunction="1" dofs="10" values="0.0" set="2"/>
      <BoundaryCondition loadtimefunction="1" dofs="10" values="150.0" isimposedtimefunction="2" set="3"/>
    </BoundaryConditions>
    <InitialConditions>
      <InitialCondition dofs="10" conditions="u 0.0" set="1"/>
    </InitialConditions>
    <LoadTimeFunctions>
      <ConstantFunction f_t_="1.0"/>
      <UsrDefLTF f_t_="h(1.*36000+1.)"/>
    </LoadTimeFunctions>
    <Sets>
      <Set elementranges="1-4"/>
      <Set nodes="1 2 3"/>
      <Set nodes="4 5 6"/>
      <Set elementboundaries="3 3 4 3"/>
    </Sets>
  </Domain>
  <ExportModules>
    <errorcheck>
      <NODE tStep="1" number="5" dof="10" unknown="d" value="0.998146959"/>
      <NODE tStep="1" number="9" dof="10" unknown="d" value="72.9756332"/>
      <NODE tStep="2" number="5" dof="10" unknown="d" value="150.0"/>
      <NODE tStep="2" number="9" dof="10" unknown="d" value="146.062022"/>
      <NODE tStep="3" number="5" dof="10" unknown="d" value="150.0"/>
      <NODE tStep="3" number="9" dof="10" unknown="d" value="219.225802"/>
    </errorcheck>
  </ExportModules>
</oofem>
