<oofem version="1">
  <Output>MPS_03.out.tm</Output>
  <Description>tests on creep at variable temperature and relative humidity</Description>
  <Analysis _="transienttransport" nsteps="23" alpha="0.5" maxiter="1000" exportfields="5 6" prescribedtimes="1e-10 0.0001 0.0002 0.0005 0.001 0.002 0.005 0.01 0.02 0.05 0.1 0.2 0.5 1.0 2.0 5.0 10.0 20.0 50.0 100.0 200.0 500.0 1000.0 2000.0"/>
  <!-- vtkxml tstep_all domain_all primvars 2 3 6 -->
  <Domain domain="hema1">
    <OutputManager tstep_all="" dofman_all="" element_all=""/>
    <Nodes>
      <!-- NODES -->
      <Node coords="0.0 0.0 0.0"/>
      <Node coords="0.1 0.0 0.0"/>
      <Node coords="0.0 0.1 0.0"/>
      <Node coords="0.1 0.1 0.0"/>
      <Node id="5" coords="0.0 0.2 0.0"/>
      <Node coords="0.1 0.2 0.0"/>
      <Node coords="0.0 0.3 0.0"/>
      <Node coords="0.1 0.3 0.0"/>
      <Node coords="0.0 0.4 0.0"/>
      <Node id="10" coords="0.1 0.4 0.0"/>
      <Node coords="0.0 0.5 0.0"/>
      <Node coords="0.1 0.5 0.0"/>
      <Node coords="0.0 0.6 0.0"/>
      <Node coords="0.1 0.6 0.0"/>
      <Node id="15" coords="0.0 0.7 0.0"/>
      <Node coords="0.1 0.7 0.0"/>
      <Node coords="0.0 0.8 0.0"/>
      <Node coords="0.1 0.8 0.0"/>
      <Node coords="0.0 0.9 0.0"/>
      <Node id="20" coords="0.1 0.9 0.0"/>
      <Node coords="0.0 1.0 0.0"/>
      <Node coords="0.1 1.0 0.0"/>
      <Node coords="0.0 1.1 0.0"/>
      <Node coords="0.1 1.1 0.0"/>
    </Nodes>
    <Elements>
      <!-- ELEMENTS -->
      <!-- reference basic + fixed temperature -->
      <quad1hmt nodes="1 2 4 3"/>
      <!-- reference drying + fixed temperature -->
      <quad1hmt nodes="5 6 8 7"/>
      <!-- elevated temperature + sealed -->
      <quad1hmt nodes="9 10 12 11"/>
      <!-- temperature cycle + sealed -->
      <quad1hmt nodes="13 14 16 15"/>
      <!-- temperature cycle + sealed (temperature cycle damping) -->
      <quad1hmt id="5" nodes="17 18 20 19"/>
      <!-- temperature cycle + drying -->
      <quad1hmt nodes="21 22 24 23"/>
    </Elements>
    <Sets>
      <Set elementranges="1-6"/>
      <Set elements="1 2"/>
      <Set elements="4"/>
      <Set elements="2 6"/>
      <Set id="5" elements="3"/>
      <Set elements="4 5 6"/>
    </Sets>
    <CrossSections>
      <!-- CROSSECTION -->
      <SimpleTransportCS thickness="1.0" mat="1" set="1"/>
    </CrossSections>
    <Materials>
      <!-- MATERIAL -->
      <hemobaznajmat d="2400.0" capa="1.0" c1="2.5e-05" alpha0="0.05" hc="0.8" n="15.0" c="1000000.0" k="1.0"/>
    </Materials>
    <BoundaryConditions>
      <!-- BOUNDARY AND INITIAL CONDITIONS -->
      <!-- constant T - "room" -->
      <BoundaryCondition loadtimefunction="1" dofs="10" values="298.0" set="2"/>
      <!-- constant h - "sealed" -->
      <BoundaryCondition loadtimefunction="2" dofs="14" values="1.0" set="3"/>
      <!-- drying -->
      <BoundaryCondition loadtimefunction="3" dofs="14" values="1.0" set="4"/>
      <!-- elevated temperature -->
      <BoundaryCondition loadtimefunction="1" dofs="10" values="348.0" set="5"/>
      <!-- temperature cycle -->
      <BoundaryCondition id="5" loadtimefunction="4" dofs="10" values="1.0" set="6"/>
    </BoundaryConditions>
    <InitialConditions>
      <InitialCondition conditions="u 298." dofs="10" set="1"/>
      <InitialCondition conditions="u 1.0" dofs="14" set="1"/>
    </InitialConditions>
    <LoadTimeFunctions>
      <!-- TIME FUNCTION -->
      <ConstantFunction f_t_="1.0"/>
      <ConstantFunction f_t_="1.0"/>
      <PiecewiseLinfunction npoints="8" t="-1000000.0 0.0 0.1 1.0 10.0 100.0 1000.0 10000.0" f_t_="1.0 1.0 1.0 0.9 0.8 0.7 0.6 0.5"/>
      <!-- -1.e6  0.0  0.1   1.  10.  100. 200. 500. 1000. 2000. 5000. 10000. -->
      <PiecewiseLinfunction npoints="12" t="-1000000.0 0.0 0.1 1.0 10.0 100.0 200.0 500.0 1000.0 2000.0 5000.0 10000.0" f_t_="298.0 298.0 298.0 298.0 300.0 330.0 300.0 250.0 250.0 330.0 300.0 330.0"/>
    </LoadTimeFunctions>
  </Domain>
