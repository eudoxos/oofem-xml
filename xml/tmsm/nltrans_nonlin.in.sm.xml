<oofem version="1">
  <Output>nltrans_nonlin.out.sm</Output>
  <Description>Quadrilateral element subjected to temperature strains</Description>
  <Analysis _="staticstructural" nsteps="3" rtolf="1e-05"/>
  <!-- vtkxml tstep_all vars 2 1 4 primvars 1 1 stype 1 -->
  <Domain domain="2dplanestress">
    <OutputManager tstep_all="" dofman_all="" element_all=""/>
    <Nodes>
      <Node coords="0.0 0.0 0.0"/>
      <Node coords="0.04 0.0 0.0"/>
      <Node coords="0.0 0.12 0.0"/>
      <Node coords="0.04 0.12 0.0"/>
    </Nodes>
    <Elements>
      <planestress2d nodes="1 2 4 3"/>
    </Elements>
    <CrossSections>
      <SimpleCS thick="1.0" material="1" set="1"/>
    </CrossSections>
    <Materials>
      <IsoLe d="2400.0" e="10000.0" n="0.15" talpha="1.2e-05"/>
    </Materials>
    <BoundaryConditions>
      <BoundaryCondition loadtimefunction="1" dofs="1 2" values="0.0 0.0" set="2"/>
      <BoundaryCondition loadtimefunction="1" dofs="2" values="0.0" set="3"/>
    </BoundaryConditions>
    <InitialConditions/>
    <LoadTimeFunctions>
      <ConstantFunction f_t_="1.0"/>
    </LoadTimeFunctions>
    <Sets>
      <Set elementranges="1"/>
      <Set nodes="1"/>
      <Set nodes="2"/>
    </Sets>
  </Domain>
  <ExportModules>
    <errorcheck tolerance="1e-08">
      <NODE tStep="1" number="2" dof="1" unknown="d" value="4.8e-06"/>
      <NODE tStep="1" number="4" dof="2" unknown="d" value="1.44e-05"/>
      <ELEMENT tStep="1" number="1" gp="1" keyword="4" component="1" value="0.00012"/>
      <NODE tStep="3" number="2" dof="1" unknown="d" value="1.44e-05"/>
      <NODE tStep="3" number="4" dof="2" unknown="d" value="4.32e-05"/>
      <ELEMENT tStep="3" number="1" gp="1" keyword="4" component="1" value="0.00036"/>
    </errorcheck>
  </ExportModules>
</oofem>
