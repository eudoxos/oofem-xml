<oofem version="1">
  <Output>concretefcmviscoelastic_out.sm</Output>
  <Description>tests on creep (mps model) with tensile cracking (fcm model)</Description>
  <Analysis _="nonlinearstatic" nsteps="500" deltat="1.0" rtolv="1e-08" maxiter="5000" controllmode="1" stiffmode="0" renumber="1" updateelasticstiffnessflag="" manrmsteps="1"/>
  <!-- vtkxml tstep_step 1 domain_all vars 2 1 4 primvars 1 1 -->
  <Domain domain="2dplanestress">
    <OutputManager tstep_all="" dofman_all="" element_all=""/>
    <Nodes>
      <!-- NODES -->
      <Node coords="0.0 0.0 0.0"/>
      <Node coords="0.1 0.0 0.0"/>
      <Node coords="0.0 0.1 0.0"/>
      <Node coords="0.1 0.1 0.0"/>
      <Node id="5" coords="0.0 0.2 0.0"/>
      <Node coords="0.1 0.2 0.0"/>
      <Node coords="0.0 0.3 0.0"/>
      <Node coords="0.1 0.3 0.0"/>
      <Node coords="0.0 0.4 0.0"/>
      <Node id="10" coords="0.1 0.4 0.0"/>
      <Node coords="0.0 0.5 0.0"/>
      <Node coords="0.1 0.5 0.0"/>
      <Node coords="0.0 0.6 0.0"/>
      <Node coords="0.1 0.6 0.0"/>
      <Node id="15" coords="0.0 0.7 0.0"/>
      <Node coords="0.1 0.7 0.0"/>
    </Nodes>
    <Elements>
      <!-- ELEMENTS -->
      <planestress2d nodes="1 2 4 3" crosssect="1"/>
      <planestress2d nodes="5 6 8 7" crosssect="2"/>
      <planestress2d nodes="9 10 12 11" crosssect="3"/>
      <planestress2d nodes="13 14 16 15" crosssect="4"/>
    </Elements>
    <CrossSections>
      <!-- CROSSECTION -->
      <SimpleCS thick="1.0" material="1"/>
      <SimpleCS thick="1.0" material="2"/>
      <SimpleCS thick="1.0" material="3"/>
      <SimpleCS thick="1.0" material="4"/>
    </CrossSections>
    <Materials>
      <!-- MATERIAL -->
      <!-- viscoelastic material with constant Gf and Ft -->
      <ConcreteFcmViscoelastic d="0.0" talpha="0.0" e="30000.0" n="0.2" gf="0.0001" ft="2.0" softtype="1" sheartype="2" sf="20.0" multiplecrackshear="" shearstrengthtype="1" ncracks="2" shearcoeffnumer="0.001" normalcoeffnumer="0.001" viscomat="4"/>
      <!-- material with evolving Gf and Ft according to fib prediction from fc28 -->
      <ConcreteFcmViscoelastic d="0.0" talpha="0.0" e="30000.0" n="0.2" gf="0.0001" ft="2.0" softtype="1" sheartype="2" sf="20.0" multiplecrackshear="" shearstrengthtype="1" ncracks="2" shearcoeffnumer="0.001" normalcoeffnumer="0.001" viscomat="4" timedepfracturing="" fib_s="0.2" fcm28="30.0" timefactor="1.0" stiffnessfactor="1000000.0"/>
      <!-- material with evolving Gf and Ft, evolution according to fib, user-defined  28-day tensile strength and fracture energy -->
      <ConcreteFcmViscoelastic d="0.0" talpha="0.0" e="30000.0" n="0.2" gf="0.0001" ft="2.0" softtype="1" sheartype="2" sf="20.0" multiplecrackshear="" shearstrengthtype="1" ncracks="2" shearcoeffnumer="0.001" normalcoeffnumer="0.001" viscomat="4" timedepfracturing="" fib_s="0.2" fcm28="30.0" timefactor="1.0" stiffnessfactor="1000000.0" ft28="2.0" gf28="0.0001"/>
      <!-- pure viscoelastic material without tensile damage, auxiliary material for materials 1-3 -->
      <mps d="0.0" n="0.2" talpha="0.0" referencetemperature="296.0" mode="0" fc="30.0" cc="340.0" w_c="0.523" a_c="5.28" stiffnessfactor="1000000.0" timefactor="1.0" lambda0="1.0" begoftimeofinterest="1e-06" endoftimeofinterest="10000.0" relmatage="7.0" coupledanalysistype="2" ksh="0.0" k3="35.0" p="1000.0"/>
    </Materials>
    <BoundaryConditions>
      <!-- BOUNDARY CONDITIONS -->
      <BoundaryCondition loadtimefunction="1" dofs="1" values="0.0" set="1"/>
      <BoundaryCondition loadtimefunction="1" dofs="2" values="0.0" set="2"/>
      <BoundaryCondition loadtimefunction="2" dofs="1" values="5e-05" set="3"/>
    </BoundaryConditions>
    <InitialConditions/>
    <LoadTimeFunctions>
      <!-- TIME FUNCTION -->
      <ConstantFunction f_t_="1.0"/>
      <PiecewiseLinFunction npoints="5" t="-10000000.0 0.0 100.0 1000.0 10000.0" f_t_="0.0 0.0 0.5 1.0 1.0"/>
    </LoadTimeFunctions>
    <Sets>
      <Set nodes="1 3 5 7 9 11 13 15"/>
      <Set nodes="1 5 9 13"/>
      <Set nodes="2 4 6 8 10 12 14 16"/>
    </Sets>
  </Domain>
  <ExportModules>
    <errorcheck>
      <REACTION tStep="25" number="2" dof="1" value="0.0864341612" tolerance="1e-08"/>
      <REACTION tStep="25" number="6" dof="1" value="0.0943445779" tolerance="1e-08"/>
      <REACTION tStep="25" number="10" dof="1" value="0.0737768215" tolerance="1e-08"/>
      <REACTION tStep="25" number="14" dof="1" value="0.124295973" tolerance="1e-08"/>
      <REACTION tStep="35" number="2" dof="1" value="0.0476909228" tolerance="1e-08"/>
      <REACTION tStep="35" number="6" dof="1" value="0.0544050636" tolerance="1e-08"/>
      <REACTION tStep="35" number="10" dof="1" value="0.0418889873" tolerance="1e-08"/>
      <!-- TIME -->
      <!-- REACTION number 2 dof 1 -->
      <!-- REACTION number 6 dof 1 -->
      <!-- REACTION number 10 dof 1 -->
      <!-- REACTION number 14 dof 1 -->
      <REACTION tStep="35" number="14" dof="1" value="0.0738939904" tolerance="1e-08"/>
    </errorcheck>
  </ExportModules>
</oofem>
