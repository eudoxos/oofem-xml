<oofem version="1">
  <Output>nltrans_nonlin.out.tm</Output>
  <Description>Quadrilateral element subjected to heat flux (Newton b.c)</Description>
  <Analysis _="TransientTransport" nsteps="3" deltat="3600.0" alpha="0.5" lumped="" exportfields="5"/>
  <!-- vtkxml tstep_all domain_all primvars 1 6 -->
  <Domain domain="heattransfer">
    <OutputManager tstep_all="" dofman_all="" element_all=""/>
    <Nodes>
      <Node coords="0.0 0.0 0.0"/>
      <Node coords="0.04 0.0 0.0"/>
      <Node coords="0.0 0.12 0.0"/>
      <Node coords="0.04 0.12 0.0"/>
    </Nodes>
    <Elements>
      <quad1ht nodes="1 2 4 3" boundaryloads="1 1 1 3"/>
    </Elements>
    <CrossSections>
      <SimpleTransportCS thickness="1.0" mat="1" set="1"/>
    </CrossSections>
    <Materials>
      <IsoHeat d="2400.0" k="1.5" c="800.0"/>
    </Materials>
    <BoundaryConditions>
      <constantedgeload loadtimefunction="1" components="-320.0" loadtype="2"/>
    </BoundaryConditions>
    <InitialConditions>
      <InitialCondition dofs="10" conditions="u 0.0" set="1"/>
    </InitialConditions>
    <LoadTimeFunctions>
      <ConstantFunction f_t_="1.0"/>
    </LoadTimeFunctions>
    <Sets>
      <Set elementranges="1"/>
      <Set elementboundaries="1 1 1 3"/>
    </Sets>
  </Domain>
  <ExportModules>
    <errorcheck>
      <NODE tStep="1" number="1" dof="10" unknown="d" value="10.0"/>
      <NODE tStep="1" number="3" dof="10" unknown="d" value="10.0"/>
      <NODE tStep="2" number="1" dof="10" unknown="d" value="20.0"/>
      <NODE tStep="2" number="3" dof="10" unknown="d" value="20.0"/>
      <NODE tStep="3" number="1" dof="10" unknown="d" value="30.0"/>
      <NODE tStep="3" number="3" dof="10" unknown="d" value="30.0"/>
    </errorcheck>
  </ExportModules>
</oofem>
