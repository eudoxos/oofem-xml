<oofem version="1">
  <Output>cemhyd01.out</Output>
  <Description>Test of cemhyd3d hydration model on one quadrilateral, Q_pot = 534 J/g_cem, 300 kg cem/m3_con, i.e. max 160.2 kJ/m3_com; deltaT=160200/2.4/870=76.724 C</Description>
  <Analysis _="TransientTransport" nsteps="51" deltat="3600.0" alpha="0.5"/>
  <!-- vtkxml tstep_all domain_all vars 11 37 39 44 56 67 68 69 70 71 72 73 stype 1 timeScale 2.777777e-4 -->
  <Domain domain="heattransfer">
    <OutputManager tstep_all="" dofman_all="" element_all=""/>
    <Nodes>
      <Node coords="0.0 0.0 0.0"/>
      <Node coords="4.0 0.0 0.0"/>
      <Node coords="4.0 1.0 0.0"/>
      <Node coords="0.0 1.0 0.0"/>
    </Nodes>
    <Elements>
      <quad1ht nodes="1 2 3 4"/>
    </Elements>
    <CrossSections>
      <SimpleTransportCS thickness="0.15" mat="1" set="1"/>
    </CrossSections>
    <Materials>
      <!-- Standard concrete k(conductivity)=1.7 W/m/K   c(capacity)=870 J/kg/K -->
      <CemhydMat d="2400.0" k="1.7" c="870." file="cemhyd01_XML.src" eachgp="0" densitytype="0" conductivitytype="0" capacitytype="0" castingtime="0.0"/>
    </Materials>
    <BoundaryConditions>
      <BoundaryCondition loadtimefunction="1" dofs="10" values="20.0"/>
    </BoundaryConditions>
    <InitialConditions>
      <!-- constantedgeload 2 loadTimeFunction 1 dofs 1 10 components 1 15.0 properties 1 a 10.8 loadtype 3 -->
      <InitialCondition dofs="10" conditions="u 20.0" set="1"/>
    </InitialConditions>
    <LoadTimeFunctions>
      <ConstantFunction f_t_="1.0"/>
    </LoadTimeFunctions>
    <Sets>
      <Set elementranges="1"/>
    </Sets>
  </Domain>
  <ExportModules>
    <errorcheck tolerance="0.001">
      <!-- TIME -->
      <!-- Check temperature -->
      <NODE tStep="5" number="1" dof="10" unknown="d" value="32.0430451"/>
      <NODE tStep="51" number="1" dof="10" unknown="d" value="84.9332076"/>
      <!-- Check degree of hydration -->
      <ELEMENT tStep="2" number="1" gp="1" keyword="39" component="1" value="0.0238356174"/>
      <ELEMENT tStep="5" number="1" gp="1" keyword="39" component="1" value="0.145163349"/>
      <ELEMENT tStep="51" number="1" gp="1" keyword="39" component="1" value="0.834227408"/>
    </errorcheck>
  </ExportModules>
</oofem>
